# Copy to .env and fill in. Nothing here is required for the DUR-1 control run
# (it uses a fake model); these are placeholders for when the spike reintroduces
# real provider calls (DUR-3) and the Neon UI store (DUR-4).

# --- LLM providers (reintroduced during the spike to test outbound I/O) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# --- UI history store (DUR-4) ---
# DATABASE_URL=postgres://...   # Neon

# --- Golem (DUR-6) ---
# GOLEM_API_URL=                # self-hosted vs Golem Cloud endpoint
